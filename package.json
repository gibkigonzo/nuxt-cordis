{
  "name": "nuxt-cordis-shop",
  "private": true,
  "version": "0.1.0",
  "description": "Modularny monolit runtime: sklep zlozony z wielu instancji Nuxt orkiestrowanych przez Cordis (spatiotemporal composability).",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./apps/**\" run build",
    "build:home": "pnpm --filter home run build",
    "build:product": "pnpm --filter product run build",
    "build:cart": "pnpm --filter cart run build",
    "build:checkout": "pnpm --filter checkout run build",
    "build:packages": "pnpm -r --filter=\"./packages/**\" --filter=\"./services/**\" run build",
    "dev": "pnpm run build && node --enable-source-maps orchestrator/src/index.ts",
    "start": "node --enable-source-maps orchestrator/src/index.ts",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
